rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Main Admin: Rayana has exclusive primary ownership & authority to manage sub-admins
    function isMainAdmin() {
      return isSignedIn() && (
        request.auth.token.email.matches('(?i)^rayanat\\.barbosa@gmail\\.com$') ||
        request.auth.token.email == 'rayanat.barbosa@gmail.com'
      );
    }

    // Sub-Admin: Authorized delegates stored in /admins collection (removable by Main Admin)
    function isSubAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
        ))
      );
    }

    // Any Admin (Main Admin or Sub-Admin) has operational access
    function isAdmin() {
      return isMainAdmin() || isSubAdmin();
    }

    // Connection test per skill directive
    match /test/{docId} {
      allow read: if true;
    }

    // Services Catalog
    match /services/{serviceId} {
      allow read: if true; // Public guest browsing
      allow create, update, delete: if isAdmin();
    }

    // Slot Locks for Conflict-Free Double-Booking Prevention
    match /slot_locks/{lockId} {
      allow read: if true;
      allow create: if request.resource.data.status in ['reserved', 'available'] &&
                       request.resource.data.appointmentDate is string &&
                       request.resource.data.startTime is string;
      allow update: if (request.resource.data.status in ['reserved', 'available'] || isAdmin());
      allow delete: if isAdmin();
    }

    // Appointments Collection
    match /appointments/{appointmentId} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          resource.data.customerId == request.auth.uid ||
          (resource.data.customerEmail is string && resource.data.customerEmail == request.auth.token.email)
        )
      );

      allow list: if isAdmin() || (
        isSignedIn() && resource.data.customerId == request.auth.uid
      );

      // Clients or guests can create appointment requests
      allow create: if request.resource.data.customerName is string &&
                       request.resource.data.customerName.size() > 0 &&
                       request.resource.data.customerName.size() <= 100 &&
                       request.resource.data.customerEmail is string &&
                       request.resource.data.customerEmail.size() <= 150 &&
                       request.resource.data.customerPhone is string &&
                       request.resource.data.customerPhone.size() <= 30 &&
                       request.resource.data.serviceName is string &&
                       request.resource.data.appointmentDate is string &&
                       request.resource.data.startTime is string &&
                       request.resource.data.status in ['pending', 'confirmed'];

      // Owner can update everything; clients can cancel/reschedule their own
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.customerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancellationReason', 'rescheduleReason', 'appointmentDate', 'startTime', 'endTime', 'updatedAt'])
      );

      allow delete: if isAdmin();
    }

    // Business operational settings
    match /business_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || (
        request.resource.data.blockedDates is list &&
        request.resource.data.businessName is string
      );
    }

    // User profiles & Admin roles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    // Admin accounts: Only the Main Admin (Rayana) can add or remove sub-admins
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isMainAdmin();
    }
  }
}
